$C = "../../Common.ui";
$S = "Styles.ui";
Group #PageFrame { Anchor: (Full: 0); Background: #000000(0.01); HitTestVisible: true;
 Group #ResultPanel { Anchor: (Width: 900, Height: 190); Visible: false; HitTestVisible: false; Background: #111d2b(0.94); Padding: (Full: 16);
  Group #WinResult { Anchor: (Full: 0); LayoutMode: Top;
   Label #WinTitle { Anchor: (Height: 92); Style: (FontSize: 72, TextColor: #ffe08d, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
   Label #WinDelta { Anchor: (Height: 64); Style: (FontSize: 44, TextColor: #ffe08d, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
  }
  Group #LossResult { Anchor: (Full: 0); Visible: false; LayoutMode: Top;
   Label #LossTitle { Anchor: (Height: 92); Style: (FontSize: 72, TextColor: #ff8677, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
   Label #LossDelta { Anchor: (Height: 64); Style: (FontSize: 44, TextColor: #ffb4a9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
  }
 }
 Group #Metrics { Anchor: (Width: 1120, Height: 64, Bottom: 254);
  Group { Anchor: (Left: 0, Width: 340, Height: 64); Background: #111d2b(0.96); Padding: (Full: 6); LayoutMode: Top;
   Label { Anchor: (Height: 22); Text: "AVAILABLE TO BET"; Style: (FontSize: 17, TextColor: #becbbe, HorizontalAlignment: Center); }
   Label #AvailableBet { Anchor: (Height: 30); Style: (FontSize: 24, TextColor: #fff5d4, RenderBold: true, HorizontalAlignment: Center); }
  }
  Group #PotentialPanel { Anchor: (Right: 0, Width: 340, Height: 64); Visible: false; Background: #17332d(0.96); Padding: (Full: 6); LayoutMode: Top;
   Label { Anchor: (Height: 22); Text: "POTENTIAL WIN"; Style: (FontSize: 17, TextColor: #c7dace, HorizontalAlignment: Center); }
   Label #PotentialWin { Anchor: (Height: 30); Style: (FontSize: 24, TextColor: #ffe08d, RenderBold: true, HorizontalAlignment: Center); }
  }
 }
 Group #Root { Anchor: (Width: 1120, Height: 184, Bottom: 60); Padding: (Full: 16); Background: #111d2b(0.96); LayoutMode: Top;
  Group { Anchor: (Height: 36); LayoutMode: Left;
   Group { Anchor: (Width: 320); }
   Label #Title { FlexWeight: 1; Style: (FontSize: 28, FontName: "Secondary", TextColor: #f5d68a, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
TextButton #RulesButton { Anchor: (Width: 110, Height: 36, Right: 10); Text: "Rules"; Style: $S.@QuietButton; }
TextButton #ManageButton { Anchor: (Width: 128, Height: 36, Right: 10); Text: "Settings"; Style: $S.@QuietButton; }
TextButton #Close { Anchor: (Width: 52, Height: 36, Right: 10); Text: "X"; Style: $S.@QuietButton; }

  }
  Group { FlexWeight: 1;
   Group #PlayView { Anchor: (Full: 0); LayoutMode: Top;
    Label #GameReadout { Anchor: (Height: 44); Style: (FontSize: 32, TextColor: #fff5d4, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Label #Round { Visible: false; Anchor: (Height: 0); Style: (FontSize: 19, TextColor: #d4debd, HorizontalAlignment: Center, VerticalAlignment: Center); }
    Group #GameStage { FlexWeight: 1; Visible: false; Background: #152c3d;
Group #DuckGame { Anchor: (Full: 0); Visible: false; Group #Lanes { Anchor: (Left: 52, Width: 1280, Top: 25); LayoutMode: Top;
Group #Lane0 { Anchor: (Height: 128); LayoutMode: Left;
 Label #Name { Anchor: (Width: 175); Text: "Open lane"; Style: (FontSize: 17, TextColor: #d5dfce, VerticalAlignment: Center); }
 Group #Track { Anchor: (Width: 900, Height: 120); Background: (TexturePath: "Art/Water.png");
  Group { Anchor: (Right: 12, Width: 4, Height: 120); Background: #ddc47a; }
  Sprite #DuckLive { Anchor: (Width: 84, Height: 60, Top: 28); Visible: false; TexturePath: "Art/Duck0Swim.png"; Frame: (Width: 64, Height: 44, PerRow: 6, Count: 12); FramesPerSecond: 30; }
  Group #DuckRest { Anchor: (Width: 84, Height: 60, Top: 28); Visible: false; Background: (TexturePath: "Duck0.png"); }
 }
 Label #Result { Anchor: (Width: 175, Left: 14); Style: (FontSize: 17, TextColor: #dfc987, VerticalAlignment: Center); }
}
